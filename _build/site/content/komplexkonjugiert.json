ss=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6595em;\"></span><span class=\"mord mathnormal\">i</span></span></span></span>","key":"aAbeLVD1rH"},{"type":"text","value":" in der Gauss-Ebene:","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hgIvkJQDBY"}],"key":"bRXoVFB1Et"}],"key":"cDL3B8fRLM"}],"key":"u5R7R5nBzN"}],"key":"xGUqZa7Ndf"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(7, 5))\n\n# Achsen\nax.annotate(\"\", xy=(4, 0), xytext=(-1.5, 0),\n            arrowprops=dict(arrowstyle=\"->\", linewidth=1.8))\nax.annotate(\"\", xy=(0, 2), xytext=(0, -2),\n            arrowprops=dict(arrowstyle=\"->\", linewidth=1.8))\n\n# Punkte z und konjugiert komplexe Zahl\nZ = (2, 1)\nConjZ = (2, -1)\n\nax.plot(Z[0], Z[1], \"ko\")\nax.plot(ConjZ[0], ConjZ[1], \"ko\")\n\n# gestrichelte Linien zur reellen Achse\nax.plot([2, 2], [0, 1], linestyle=\"--\")\nax.plot([2, 2], [0, -1], linestyle=\"--\")\n\n# Strecken vom Ursprung\nax.plot([0, Z[0]], [0, Z[1]], linewidth=2)\nax.plot([0, ConjZ[0]], [0, ConjZ[1]], linewidth=2)\n\n# Beschriftungen\nax.text(4.1, -0.1, \"Re\", fontsize=11)\nax.text(0.1, 2.05, \"Im\", fontsize=11)\n\nax.text(2.1, 1.1, r\"$z = 2 + i$\", fontsize=12)\nax.text(2.1, -1.25, r\"$\\bar{z} = 2 - i$\", fontsize=12)\n\nax.text(2, -0.2, \"2\", ha=\"center\", fontsize=11)\nax.text(0.12, 1, \"1\", va=\"center\", fontsize=11)\nax.text(0.12, -1, \"-1\", va=\"center\", fontsize=11)\n\nax.set_xlim(-1.5, 4.3)\nax.set_ylim(-2.2, 2.2)\nax.set_aspect(\"equal\")\nax.axis(\"off\")\n\nplt.show()","visibility":"hide","key":"KtdU5zvxDf"},{"type":"outputs","id":"NFNOnZ2LcuLu6KlXYAgEj","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"149d3998fd132fb36a46ae21ca5b3c62","path":"/149d3998fd132fb36a46ae21ca5b3c62.png"},"text/plain":{"content":"<Figure size 700x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"w3I5p5SURl"}],"visibility":"show","key":"Xm0jtwVouy"}],"visibility":"show","key":"cMrlL4Lu2e"}],"key":"cKEAHxdQQ3"},"references":{"cite":{"order":[],"data":{}}}}